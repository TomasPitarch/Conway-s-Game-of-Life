
#SidePanel {
    background-color: rgba(25, 25, 25, 0.95);
    border-width: 2px;
    border-color: rgba(0, 255, 156, 0.3);
    border-radius: 20px;
    padding: 15px;
    width: 340px;
    transition-duration: 300ms;
}

.section-header {
    margin-top: 12px;
    margin-bottom: 5px;
    -unity-font-style: bold;
    color: rgb(170, 170, 170);
    font-size: 11px;
    border-bottom-width: 1px;
    border-bottom-color: rgba(170, 170, 170, 0.2);
}

.unity-button {
    border-radius: 8px;
    border-width: 0;
    padding: 8px;
    margin-top: 5px;
    margin-bottom: 5px;
    color: white;
    font-size: 14px;
    -unity-font-style: bold;
    transition-duration: 100ms;
}

.unity-button:hover {
    scale: 1.05;
    background-color: #333333;
}

#BtnStart { background-color: #2D5A27; }
#BtnStart:hover { background-color: #3E7C36; border-color: #00FF9C; border-width: 1px; }

#BtnPause { background-color: #5A4A27; }
#BtnPause:hover { background-color: #7A6535; }

.config-button {
    background-color: #444444;
    font-size: 12px;
}

.quit-button {
    background-color: #5A2727;
    margin-top: 15px;
}
.quit-button:hover {
    background-color: #7A3535;
}

.data-display-container {
    flex-direction: row;
    justify-content: space-between;
    background-color: rgba(0, 0, 0, 0.4);
    padding: 5px 10px;
    border-radius: 8px;
    margin-bottom: 3px;
}

.data-title {
    color: #AAAAAA;
    font-size: 11px;
}

.data-label {
    color: #00FF9C;
    -unity-font-style: bold;
    font-size: 12px;
}

.unity-base-field__label {
    color: #CCCCCC;
    min-width: 70px;
    font-size: 11px;
}

.unity-integer-field__input, .unity-text-field__input, .unity-base-dropdown__input {
    background-color: #111111;
    border-color: #333333;
    border-radius: 4px;
    color: #00FF9C;
    padding: 1px 5px;
}

.unity-base-slider__dragger {
    background-color: #00FF9C;
    border-radius: 10px;
}

.unity-slider-int, .unity-slider {
    margin-top: 4px;
    margin-bottom: 4px;
}

#SliderBrushRadius {
    margin-top: 8px;
    margin-bottom: 12px;
}

.color-picker-section {
    background-color: rgba(0, 0, 0, 0.2);
    padding: 5px;
    border-radius: 5px;
    margin-bottom: 5px;
}

.color-preview {
    width: 40px;
    height: 15px;
    border-radius: 3px;
    border-width: 1px;
    border-color: #555555;
}

.compact-slider {
    margin: 0;
    padding: 0;
}

#SliderBrushRadius {
    margin-top: 12px;
    margin-bottom: 20px;
    height: 40px;
}

.compact-slider .unity-base-slider__label {
    min-width: 20px;
    font-size: 10px;
}
