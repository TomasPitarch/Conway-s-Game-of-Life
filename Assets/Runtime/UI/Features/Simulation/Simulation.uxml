<ui:UXML xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" editor-extension-mode="False">
    <Style src="project://database/Assets/Runtime/UI/Features/Simulation/Simulation.uss" />
    <Style src="project://database/Assets/Runtime/UI/Components/RuntimeColorPicker/RuntimeColorPicker.uss" />
    <ui:VisualElement name="MainContainer" style="flex-direction: row; height: 100%; width: 100%; align-self: auto;">
        <ui:VisualElement name="SidePanel" style="align-self: center; justify-content: flex-start;">
            <ui:Label text="GAME OF LIFE" style="-unity-font-style: bold; font-size: 22px; margin-bottom: 10px; align-self: center; color: rgb(0, 255, 156);"/>

            <ui:Label text="STATISTICS" class="section-header"/>
            <ui:VisualElement class="data-display-container">
                <ui:Label text="FPS:" class="data-title"/>
                <ui:Label name="LabelFPS" text="0" class="data-label"/>
            </ui:VisualElement>
            <ui:VisualElement class="data-display-container">
                <ui:Label text="Speed:" class="data-title"/>
                <ui:Label name="LabelCurrentSpeed" text="0 CPS" class="data-label"/>
            </ui:VisualElement>
            <ui:VisualElement class="data-display-container">
                <ui:Label text="Cells:" class="data-title"/>
                <ui:Label name="LabelAliveCount" text="0" class="data-label"/>
            </ui:VisualElement>

            <ui:Label text="SIMULATION" class="section-header"/>
            <ui:DropdownField name="DropdownStrategy" label="Strategy"/>
            <ui:Slider name="SliderSpeed" label="Speed" low-value="1" high-value="120" value="60"/>
            <ui:IntegerField name="FieldTargetCells" label="Seed" value="50000"/>

            <ui:Label text="RENDER" class="section-header"/>
            <ui:VisualElement style="flex-direction: row;">
                <ui:IntegerField name="FieldWidth" label="W" value="512" style="flex-grow: 1;"/>
                <ui:IntegerField name="FieldHeight" label="H" value="512" style="flex-grow: 1;"/>
            </ui:VisualElement>
            <ui:Button name="BtnApplyDimensions" text="Resize &amp; Reset" class="config-button"/>

            <ui:Label text="COLORS" class="section-header"/>
            <ui:VisualElement class="color-picker-section">
                <ui:Label text="Live Color" style="font-size: 11px; color: #AAAAAA; margin-bottom: 5px;"/>
                <GameOfLife.UI.RuntimeColorPicker name="PickerLive" />
            </ui:VisualElement>

            <ui:VisualElement class="color-picker-section">
                <ui:Label text="Dead Color" style="font-size: 11px; color: #AAAAAA; margin-bottom: 5px;"/>
                <GameOfLife.UI.RuntimeColorPicker name="PickerDead" />
            </ui:VisualElement>

            <ui:Label text="CONTROLS" class="section-header"/>
            <ui:VisualElement style="flex-direction: row; justify-content: space-between;">
                <ui:Button name="BtnStart" text="Start" style="flex-grow: 1;"/>
                <ui:Button name="BtnPause" text="Pause" style="flex-grow: 1;"/>
            </ui:VisualElement>

            <ui:Button name="BtnQuit" text="Exit Game" class="quit-button"/>
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
